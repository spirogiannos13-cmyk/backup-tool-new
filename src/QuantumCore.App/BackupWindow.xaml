<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="QuantumCore.App.BackupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Create Backup — Quantum Core" Width="760" Height="700"
        MinWidth="680" MinHeight="620" WindowStartupLocation="CenterOwner"
        Background="#0B1627" Foreground="#EDF7FF" FontFamily="Segoe UI">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#EAF8FF"/>
            <Setter Property="Background" Value="#183653"/>
            <Setter Property="BorderBrush" Value="#315777"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#087FC4"/>
            <Setter Property="BorderBrush" Value="#20C6E8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#101F33"/>
            <Setter Property="Foreground" Value="#EDF7FF"/>
            <Setter Property="BorderBrush" Value="#31506F"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="CaretBrush" Value="#55E5FF"/>
        </Style>
    </Window.Resources>
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,22">
            <TextBlock Text="QUANTUM CORE / NEW OPERATION" Foreground="#55DDF7" FontSize="10"/>
            <TextBlock Text="Create backup" FontSize="28" FontWeight="SemiBold" Margin="0,6,0,4"/>
            <TextBlock Text="Choose what to protect and where to store your backup." Foreground="#8CA7C5" FontSize="13"/>
        </StackPanel>
        <StackPanel Grid.Row="1" Margin="0,0,0,18">
            <TextBlock Text="01  SOURCE DATA" Foreground="#55DDF7" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,9"/>
            <Border Background="#101F33" BorderBrush="#294563" BorderThickness="1" CornerRadius="10" Padding="10">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="+ Add files" Click="AddFiles_Click"/>
                        <Button Content="+ Add folder" Click="AddFolder_Click" Margin="0"/>
                    </StackPanel>
                    <TextBlock Text="Add one or more files and folders to this backup." Foreground="#8CA7C5" VerticalAlignment="Center" TextWrapping="Wrap"/>
                </DockPanel>
            </Border>
        </StackPanel>
        <Grid Grid.Row="2">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <TextBlock Text="SELECTED ITEMS" Foreground="#7894B2" FontSize="9" Margin="2,0,0,7"/>
            <ListBox x:Name="SourcesList" Grid.Row="1" Background="#0E1B2D" Foreground="#D9EDFF" BorderBrush="#294563" Padding="7" SelectionMode="Extended"/>
        </Grid>
        <StackPanel Grid.Row="3" Margin="0,18,0,0">
            <TextBlock Text="02  BACKUP DESTINATION" Foreground="#55DDF7" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,9"/>
            <ComboBox x:Name="DestinationModeCombo" SelectedIndex="0" SelectionChanged="DestinationModeCombo_SelectionChanged"
                      Background="#101F33" Foreground="#EDF7FF" BorderBrush="#31506F" Padding="8" Margin="0,0,0,9">
                <ComboBoxItem Content="Local folder"/>
                <ComboBoxItem Content="MEGA cloud"/>
            </ComboBox>
            <DockPanel x:Name="LocalDestinationPanel">
                <Button DockPanel.Dock="Right" Content="Browse…" Click="BrowseDestination_Click" Margin="8,0,0,0"/>
                <TextBox x:Name="DestinationBox" IsReadOnly="True" Text="Select a destination folder…" VerticalContentAlignment="Center"/>
            </DockPanel>
            <TextBlock x:Name="StatusText" Text="Ready when you are. Source files are copied; originals are never modified." Foreground="#7894B2" FontSize="11" TextWrapping="Wrap" Margin="2,10,0,0"/>
            <ProgressBar x:Name="BackupProgress" Height="7" Margin="0,12,0,0" Background="#1B3049" Foreground="#20C6E8" Minimum="0" Maximum="100"/>
        </StackPanel>
        <DockPanel Grid.Row="4" Margin="0,22,0,0">
            <TextBlock x:Name="ProgressLabel" Text="0%" Foreground="#8CA7C5" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button x:Name="CancelButton" Content="Cancel" Click="Cancel_Click"/>
                <Button x:Name="StartButton" Style="{StaticResource PrimaryButton}" Content="▶  Start backup" Click="StartBackup_Click" Margin="0"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>