<Window x:Class="QuantumCore.App.SchedulesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Backup Automation — Quantum Core" Width="1240" Height="860"
        MinWidth="1080" MinHeight="740" WindowStartupLocation="CenterOwner"
        Background="#0B1627" Foreground="#EDF7FF" FontFamily="Segoe UI">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#EAF8FF"/>
            <Setter Property="Background" Value="#183653"/>
            <Setter Property="BorderBrush" Value="#315777"/>
            <Setter Property="Padding" Value="13,9"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#F7FBFF"/>
            <Setter Property="Foreground" Value="#075A9C"/>
            <Setter Property="BorderBrush" Value="#FFFFFF"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#F7FBFF"/>
            <Setter Property="Foreground" Value="#075A9C"/>
            <Setter Property="BorderBrush" Value="#FFFFFF"/>
            <Setter Property="Padding" Value="9,7"/>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#075A9C"/>
            <Setter Property="Padding" Value="8,6"/>
        </Style>
    </Window.Resources>
    <Grid Margin="34,30,34,26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,26">
            <TextBlock Text="QUANTUM CORE / AUTOMATION" Foreground="#55DDF7" FontSize="10"/>
            <TextBlock Text="Scheduled Business Backup" FontSize="30" FontWeight="SemiBold" Margin="0,6,0,4"/>
            <TextBlock Text="Automate the complete business backup and safely overwrite the MEGA copy." Foreground="#8CA7C5"/>
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.94*"/>
                <ColumnDefinition Width="1.06*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="#101F33" BorderBrush="#31516F" BorderThickness="1" CornerRadius="16" Padding="22" Margin="0,0,16,0">
                <StackPanel>
                    <TextBlock Text="NEW AUTOMATION" Foreground="#55DDF7" FontSize="11" FontWeight="Bold" Margin="0,0,0,20"/>
                    <TextBlock Text="Create a daily protection routine" Foreground="#DCEEFF" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,16"/>
                    <TextBlock Text="BACKUP PROFILE" Foreground="#8CA7C5" FontSize="10"/>
                    <Border Background="#0B263D" BorderBrush="#1C9CC7" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,6,0,14">
                        <StackPanel>
                            <TextBlock Text="FULL BUSINESS BACKUP" Foreground="#55DDF7" FontWeight="SemiBold"/>
                            <TextBlock Text="Printers · Sunsoft configs · Registry · SQL compressed .bak · form_path · web.config"
                                       Foreground="#B6CBE0" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="SQL SERVER CONNECTION" Foreground="#8CA7C5" FontSize="10"/>
                    <ComboBox x:Name="SqlConnectionCombo" DisplayMemberPath="Name" SelectionChanged="SqlConnectionCombo_SelectionChanged" Margin="0,6,0,8"/>
                    <Button Content="Load SQL databases" Click="LoadDatabases_Click" HorizontalAlignment="Left"/>
                    <TextBlock Text="DATABASE" Foreground="#8CA7C5" FontSize="10" Margin="0,12,0,5"/>
                    <ComboBox x:Name="DatabaseCombo"/>
                    <TextBlock Text="DESTINATION" Foreground="#8CA7C5" FontSize="10" Margin="0,14,0,5"/>
                    <Border Background="#0B263D" BorderBrush="#1C9CC7" BorderThickness="1" CornerRadius="6" Padding="10">
                        <DockPanel>
                            <TextBlock Text="MEGA CLOUD" Foreground="#55DDF7" FontWeight="SemiBold"/>
                            <TextBlock Text=" · QuantumCore_Backup.zip (overwrite)" Foreground="#B6CBE0" FontSize="11"/>
                        </DockPanel>
                    </Border>
                    <TextBlock Text="FREQUENCY" Foreground="#8CA7C5" FontSize="10" Margin="0,14,0,5"/>
                    <TextBlock Text="Every day" Foreground="#EDF7FF" FontWeight="SemiBold"/>
                    <TextBlock Text="START TIME (24-HOUR FORMAT)" Foreground="#8CA7C5" FontSize="10" Margin="0,12,0,5"/>
                    <TextBox x:Name="TimeBox" Text="03:00"/>
                    <Button x:Name="SaveScheduleButton" Content="＋  SAVE DAILY SCHEDULE" Background="#087FC4" BorderBrush="#20C6E8" FontWeight="SemiBold"
                            HorizontalAlignment="Stretch" Margin="0,18,0,0" Click="SaveSchedule_Click"/>
                    <TextBlock x:Name="StatusText" Foreground="#8CA7C5" FontSize="11" TextWrapping="Wrap" Margin="0,12,0,0"/>
                </StackPanel>
            </Border>
            <Grid Grid.Column="1">
                <Grid.RowDefinitions><RowDefinition Height="0.82*"/><RowDefinition Height="1.18*"/></Grid.RowDefinitions>
                <Border Grid.Row="0" Background="#101F33" BorderBrush="#31516F" BorderThickness="1" CornerRadius="16" Padding="20" Margin="0,0,0,12">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                            <TextBlock Text="ACTIVE AUTOMATIONS" Foreground="#55DDF7" FontSize="11" FontWeight="Bold"/>
                            <TextBlock Text="Registered with Windows Task Scheduler" Foreground="#8CA7C5" FontSize="11" Margin="0,5,0,0"/>
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                            <Button Content="Refresh" Click="Refresh_Click"/>\n                            <Button Content="Modify selected" Click="ModifySchedule_Click"/>
                            <Button Content="Remove selected" Click="RemoveSchedule_Click" Margin="0"/>
                        </StackPanel>
                        <ListBox x:Name="SchedulesList" Background="#0A1728" Foreground="#D9EDFF" BorderBrush="#294563" Padding="9" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="4,3"/></DataTemplate></ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
                <Border Grid.Row="1" Background="#101F33" BorderBrush="#294563" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,12,0,0">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                            <TextBlock Text="EXECUTION HISTORY" Foreground="#55DDF7" FontSize="11" FontWeight="SemiBold"/>
                            <TextBlock Text="Latest 20 scheduled runs, including errors and transferred size" Foreground="#8CA7C5" FontSize="11" Margin="0,5,0,0"/>
                        </StackPanel>
                        <ListBox x:Name="HistoryList" Background="#0A1728" Foreground="#D9EDFF" BorderBrush="#294563" Padding="9" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="4,4"/></DataTemplate></ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
        <TextBlock Grid.Row="2" Text="Your PC must be awake, connected to the Internet, and signed in to Windows at the scheduled time. Scheduled runs use your saved Windows, SQL and MEGA credentials."
                   Foreground="#7894B2" FontSize="11" TextWrapping="Wrap" Margin="2,16,2,0"/>
    </Grid>
</Window>