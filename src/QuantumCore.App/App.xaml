<Application x:Class="QuantumCore.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <Color x:Key="Space">#080F1D</Color>
        <Color x:Key="Panel">#101D31</Color>
        <Color x:Key="PanelRaised">#142640</Color>
        <Color x:Key="ElectricBlue">#269BFF</Color>
        <Color x:Key="NeonCyan">#48E5FF</Color>
        <Color x:Key="MutedText">#8CA7C5</Color>
        <SolidColorBrush x:Key="SpaceBrush" Color="{StaticResource Space}" />
        <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource Panel}" />
        <SolidColorBrush x:Key="PanelRaisedBrush" Color="{StaticResource PanelRaised}" />
        <SolidColorBrush x:Key="ElectricBlueBrush" Color="{StaticResource ElectricBlue}" />
        <SolidColorBrush x:Key="NeonCyanBrush" Color="{StaticResource NeonCyan}" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="{StaticResource MutedText}" />
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#EDF7FF" />
    </Application.Resources>
</Application>