<Window x:Class="QuantumCore.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QUANTUM CORE" Width="1440" Height="900" MinWidth="1120" MinHeight="720"
        WindowStartupLocation="CenterScreen" Background="#080F1D" Foreground="#EDF7FF" FontFamily="Segoe UI">
    <Window.Resources>
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Foreground" Value="#A9C0DA"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="15,12"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,2,0,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#183653"/>
                                <Setter Property="Foreground" Value="#55E5FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#21496D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="#F4FBFF"/>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#1679D4" Offset="0"/>
                        <GradientStop Color="#13BBD9" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="19,12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <Border.Effect><DropShadowEffect Color="#269BFF" BlurRadius="16" ShadowDepth="0" Opacity="0.3"/></Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.86"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.7"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PanelCard" TargetType="Border">
            <Setter Property="Background" Value="#101D31"/>
            <Setter Property="BorderBrush" Value="#263F5E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="20"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#55DDF7"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.Background>
            <RadialGradientBrush GradientOrigin="0.8,0.05" Center="0.8,0.05" RadiusX="0.95" RadiusY="0.95">
                <GradientStop Color="#102C4B" Offset="0"/>
                <GradientStop Color="#080F1D" Offset="0.72"/>
            </RadialGradientBrush>
        </Grid.Background>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="252"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#091422" BorderBrush="#1B3049" BorderThickness="0,0,1,0">
            <DockPanel Margin="18,24">
                <Border DockPanel.Dock="Bottom" Background="#101F33" BorderBrush="#294563" BorderThickness="1" CornerRadius="11" Padding="13" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="CORE STATUS" FontSize="9" Foreground="#7894B2" FontWeight="Bold"/>
                        <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                            <Ellipse Width="7" Height="7" Fill="#47E6B0" VerticalAlignment="Center"/>
                            <TextBlock Text="  Systems ready" FontSize="11" Foreground="#B8D0E7"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <StackPanel DockPanel.Dock="Top">
                    <StackPanel Orientation="Horizontal" Margin="3,0,0,34">
                        <Grid Width="36" Height="36">
                            <Ellipse Stroke="#37CFFF" StrokeThickness="1.5"/>
                            <Ellipse Width="12" Height="12" Fill="#37CFFF">
                                <Ellipse.Effect><DropShadowEffect Color="#37CFFF" BlurRadius="15" ShadowDepth="0"/></Ellipse.Effect>
                            </Ellipse>
                        </Grid>
                        <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="QUANTUM" FontSize="15" FontWeight="Bold" Foreground="#F2FAFF"/>
                            <TextBlock Text="CORE SYSTEMS" FontSize="9" Foreground="#53DDF8"/>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="COMMAND CENTER" Foreground="#58738F" FontSize="10" FontWeight="Bold" Margin="12,0,0,10"/>
                    <Button x:Name="OverviewNav" Style="{StaticResource NavButton}" Background="#142B45" Foreground="#55E5FF" Content="◈    Overview" Click="Overview_Click"/>
                    <Button Style="{StaticResource NavButton}" Content="▣    Backup Jobs" Click="Backups_Click"/>
                    <Button Style="{StaticResource NavButton}" Content="◷    Automation" Click="Automation_Click"/>
                    <Button Style="{StaticResource NavButton}" Content="▤    History &amp; Logs" Click="History_Click"/>
                    <TextBlock Text="CONFIGURATION" Foreground="#58738F" FontSize="10" FontWeight="Bold" Margin="12,25,0,10"/>
                    <Button Style="{StaticResource NavButton}" Content="▦    SQL Manager" Click="SqlConnections_Click"/>
                    <Button Style="{StaticResource NavButton}" Content="◇    Cloud &amp; Storage" Click="Cloud_Click"/>
                    <Button Style="{StaticResource NavButton}" Content="⚙    Settings" Click="Settings_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Margin="34,27,34,24">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock x:Name="BreadcrumbText" Text="COMMAND CENTER / OVERVIEW" Foreground="#55DDF7" FontSize="10" FontWeight="SemiBold"/>
                    <TextBlock x:Name="PageTitleText" Text="Quantum Operations" FontSize="29" FontWeight="SemiBold" Margin="0,6,0,3"/>
                    <TextBlock x:Name="PageSubtitleText" Text="Your backup environment, unified in one command space." FontSize="12" Foreground="#8CA7C5"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <Border Background="#102A3A" BorderBrush="#23617A" BorderThickness="1" CornerRadius="20" Padding="11,7" Margin="0,3,10,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Fill="#48E5B5" VerticalAlignment="Center"/>
                            <TextBlock Text="  SYSTEM READY" FontSize="9" Foreground="#8FEBD0" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>
                    <Button Style="{StaticResource PrimaryButton}" Content="＋  NEW BACKUP" Click="NewBackup_Click"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <!-- OVERVIEW -->
                <ScrollViewer x:Name="OverviewPage" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource PanelCard}" Margin="0,0,10,0">
                                <StackPanel><TextBlock Text="BACKUPS THIS SESSION" Foreground="#8CA7C5" FontSize="10"/>
                                    <TextBlock x:Name="TotalBackupsValue" Text="0" FontSize="30" FontWeight="Light" Margin="0,7,0,1"/>
                                    <TextBlock x:Name="TotalBackupsCaption" Text="No new backups yet" FontSize="10" Foreground="#6886A5"/></StackPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource PanelCard}" Margin="5,0">
                                <StackPanel><TextBlock Text="LATEST BACKUP SIZE" Foreground="#8CA7C5" FontSize="10"/>
                                    <TextBlock x:Name="LastBackupValue" Text="—" FontSize="30" FontWeight="Light" Margin="0,7,0,1"/>
                                    <TextBlock Text="Completed operation" FontSize="10" Foreground="#6886A5"/></StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource PanelCard}" Margin="10,0,0,0">
                                <StackPanel><TextBlock Text="LAST OPERATION" Foreground="#8CA7C5" FontSize="10"/>
                                    <TextBlock x:Name="LastBackupTimeValue" Text="—" FontSize="30" FontWeight="Light" Margin="0,7,0,1"/>
                                    <TextBlock x:Name="LastBackupCaption" Text="No operations performed" FontSize="10" Foreground="#6886A5"/></StackPanel>
                            </Border>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="0.9*"/></Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource PanelCard}" Margin="0,0,10,0" MinHeight="390">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <StackPanel><TextBlock Style="{StaticResource SectionTitle}" Text="QUANTUM CORE"/>
                                        <TextBlock Text="Operations Monitor" FontSize="19" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel>
                                    <Grid Grid.Row="1" MinHeight="270">
                                        <Ellipse x:Name="CoreGlow" Width="190" Height="190" Fill="#123F70" Opacity="0.55"><Ellipse.Effect><BlurEffect Radius="35"/></Ellipse.Effect></Ellipse>
                                        <Ellipse x:Name="CoreRing" Width="154" Height="154" Stroke="#258DCE" StrokeThickness="1.2" Opacity="0.8"/>
                                        <Ellipse Width="122" Height="122" Stroke="#3DDFFF" StrokeThickness="1.5" Opacity="0.75">
                                            <Ellipse.Fill><RadialGradientBrush><GradientStop Color="#246A9A" Offset="0"/><GradientStop Color="#102A49" Offset="0.7"/><GradientStop Color="#0C1B30" Offset="1"/></RadialGradientBrush></Ellipse.Fill>
                                            <Ellipse.Effect><DropShadowEffect Color="#21BFFF" BlurRadius="30" ShadowDepth="0" Opacity="0.8"/></Ellipse.Effect>
                                        </Ellipse>
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="CORE" FontSize="10" Foreground="#8DEBFF" HorizontalAlignment="Center"/>
                                            <TextBlock x:Name="CoreStateText" Text="IDLE" FontSize="21" FontWeight="Light" Foreground="White" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Ellipse Width="6" Height="6" Fill="#45E6B4" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="ActivityStatusText" Text="  No active operations" FontSize="11" Foreground="#8CA7C5"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <StackPanel Grid.Column="1">
                                <Border Style="{StaticResource PanelCard}" Margin="0,0,0,12">
                                    <StackPanel><TextBlock Style="{StaticResource SectionTitle}" Text="QUICK ACTIONS"/>
                                        <Button Style="{StaticResource PrimaryButton}" Content="＋  Create a backup" HorizontalAlignment="Stretch" Margin="0,14,0,8" Click="NewBackup_Click"/>
                                        <Button Style="{StaticResource NavButton}" Content="◷  Manage automation" Click="Automation_Click"/>
                                        <Button Style="{StaticResource NavButton}" Content="▦  SQL connections" Click="SqlConnections_Click"/></StackPanel>
                                </Border>
                                <Border Style="{StaticResource PanelCard}">
                                    <StackPanel><TextBlock Style="{StaticResource SectionTitle}" Text="LATEST ACTIVITY"/>
                                        <TextBlock x:Name="ActivityTitle" Text="Awaiting first operation" FontSize="14" Margin="0,14,0,5"/>
                                        <TextBlock x:Name="ActivityDescription" Text="Backup progress and operation details will appear here." TextWrapping="Wrap" Foreground="#7894B2" FontSize="11" LineHeight="18"/></StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <!-- BACKUP JOBS -->
                <ScrollViewer x:Name="BackupsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Style="{StaticResource PanelCard}" Margin="0,0,0,14">
                            <StackPanel><TextBlock Style="{StaticResource SectionTitle}" Text="BACKUP WORKSPACE"/>
                                <TextBlock Text="Create and manage backup operations" FontSize="19" FontWeight="SemiBold" Margin="0,6,0,5"/>
                                <TextBlock Text="Start a manual backup or configure the complete Business Backup workflow." Foreground="#8CA7C5" FontSize="12" TextWrapping="Wrap"/>
                                <Button Style="{StaticResource PrimaryButton}" Content="＋  START NEW BACKUP" HorizontalAlignment="Left" Margin="0,18,0,0" Click="NewBackup_Click"/></StackPanel>
                        </Border>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource PanelCard}" Margin="0,0,8,0">
                                <StackPanel><TextBlock Style="{StaticResource SectionTitle}" Text="MANUAL BACKUP"/>
                                    <TextBlock Text="Choose the backup source, destination and options in the backup wizard." Foreground="#A9C0DA" TextWrapping="Wrap" Margin="0,9,0,14"/>
                                    <Button Style="{StaticResource NavButton}" Content="Open backup wizard  →" Click="NewBackup_Click"/></StackPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource PanelCard}" Margin="8,0,0,0">
                                <StackPanel><TextBlock Style="{StaticResource SectionTitle}" Text="AUTOMATED BUSINESS BACKUP"/>
                                    <TextBlock Text="Full business package, compressed SQL backup and MEGA upload." Foreground="#A9C0DA" TextWrapping="Wrap" Margin="0,9,0,14"/>
                                    <Button Style="{StaticResource NavButton}" Content="Configure automation  →" Click="Automation_Click"/></StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <!-- AUTOMATION -->
                <ScrollViewer x:Name="AutomationPage" Visibility="Collapsed">
                    <StackPanel>
                        <Border Style="{StaticResource PanelCard}">
                            <TextBlock Style="{StaticResource SectionTitle}" Text="SCHEDULED OPERATIONS"/>
                            <TextBlock Text="Automate your protection routine" FontSize="20" FontWeight="SemiBold" Margin="0,7,0,5"/>
                            <TextBlock Text="Configure the daily full Business Backup, choose its SQL database and destination, and review registered tasks." Foreground="#A9C0DA" TextWrapping="Wrap"/>
                            <Button Style="{StaticResource PrimaryButton}" Content="OPEN AUTOMATION MANAGER  →" HorizontalAlignment="Left" Margin="0,20,0,0" Click="Schedules_Click"/>
                        </Border>
                        <Border Style="{StaticResource PanelCard}" Margin="0,14,0,0">
                            <TextBlock Style="{StaticResource SectionTitle}" Text="REQUIREMENTS"/>
                            <TextBlock Text="Windows must be signed in, the computer awake and connected to the Internet. SQL and MEGA credentials must be saved for unattended runs." Foreground="#8CA7C5" TextWrapping="Wrap" Margin="0,8,0,0"/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- HISTORY -->
                <ScrollViewer x:Name="HistoryPage" Visibility="Collapsed">
                    <StackPanel>
                        <Border Style="{StaticResource PanelCard}">
                            <TextBlock Style="{StaticResource SectionTitle}" Text="EXECUTION HISTORY"/>
                            <TextBlock Text="Review scheduled backup runs" FontSize="20" FontWeight="SemiBold" Margin="0,7,0,5"/>
                            <TextBlock Text="The automation manager contains the latest scheduled executions, including timestamps, duration, transferred size and error details." Foreground="#A9C0DA" TextWrapping="Wrap"/>
                            <Button Style="{StaticResource PrimaryButton}" Content="OPEN HISTORY &amp; LOGS  →" HorizontalAlignment="Left" Margin="0,20,0,0" Click="Schedules_Click"/>
                        </Border>
                        <Border Style="{StaticResource PanelCard}" Margin="0,14,0,0">
                            <TextBlock Style="{StaticResource SectionTitle}" Text="LOG FILE LOCATION"/>
                            <TextBlock Text="%LOCALAPPDATA%\QuantumCore\scheduled-backups.log" Foreground="#55DDF7" TextWrapping="Wrap" Margin="0,8,0,0"/>
                            <TextBlock Text="History data: scheduled-backup-history.json" Foreground="#8CA7C5" Margin="0,5,0,0"/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- SQL -->
                <ScrollViewer x:Name="SqlPage" Visibility="Collapsed">
                    <StackPanel>
                        <Border Style="{StaticResource PanelCard}">
                            <TextBlock Style="{StaticResource SectionTitle}" Text="DATA SOURCES"/>
                            <TextBlock Text="SQL Connection Manager" FontSize="20" FontWeight="SemiBold" Margin="0,7,0,5"/>
                            <TextBlock Text="Save SQL Server connections, test authentication and select databases for backup operations." Foreground="#A9C0DA" TextWrapping="Wrap"/>
                            <Button Style="{StaticResource PrimaryButton}" Content="MANAGE SQL CONNECTIONS  →" HorizontalAlignment="Left" Margin="0,20,0,0" Click="OpenSqlManager_Click"/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- CLOUD -->
                <ScrollViewer x:Name="CloudPage" Visibility="Collapsed">
                    <StackPanel>
                        <Border Style="{StaticResource PanelCard}">
                            <TextBlock Style="{StaticResource SectionTitle}" Text="CLOUD DESTINATIONS"/>
                            <TextBlock Text="MEGA Cloud Storage" FontSize="20" FontWeight="SemiBold" Margin="0,7,0,5"/>
                            <TextBlock Text="MEGA is used as the cloud destination for the scheduled full Business Backup. The saved account session is protected for the current Windows user." Foreground="#A9C0DA" TextWrapping="Wrap"/>
                            <TextBlock Text="Account sign-in and session replacement are handled from the backup workflow. A dedicated cloud account panel can be added here as the next UI step." Foreground="#7894B2" TextWrapping="Wrap" Margin="0,12,0,0"/>
                            <Button Style="{StaticResource PrimaryButton}" Content="OPEN BACKUP WORKFLOW  →" HorizontalAlignment="Left" Margin="0,20,0,0" Click="NewBackup_Click"/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- SETTINGS -->
                <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed">
                    <StackPanel>
                        <Border Style="{StaticResource PanelCard}">
                            <TextBlock Style="{StaticResource SectionTitle}" Text="SYSTEM CONFIGURATION"/>
                            <TextBlock Text="Quantum Core Settings" FontSize="20" FontWeight="SemiBold" Margin="0,7,0,5"/>
                            <TextBlock Text="The settings area is reserved for application preferences, notifications, appearance and retention policies. Existing backup and SQL settings remain in their dedicated managers." Foreground="#A9C0DA" TextWrapping="Wrap"/>
                            <TextBlock Text="More controls will appear here as they become available." Foreground="#55DDF7" Margin="0,14,0,0"/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <Grid Grid.Row="2" Margin="0,16,0,0" VerticalAlignment="Bottom" IsHitTestVisible="False">
                <TextBlock Text="QUANTUM CORE  •  WINDOWS DESKTOP" FontSize="9" Foreground="#526D89"/>
            </Grid>
        </Grid>
    </Grid>
    <Window.Triggers>
        <EventTrigger RoutedEvent="Loaded"><BeginStoryboard Storyboard="{StaticResource CorePulse}"/></EventTrigger>
    </Window.Triggers>
</Window>