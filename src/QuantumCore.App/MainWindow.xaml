<Window x:Class="QuantumCore.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quantum Core"
        Width="1440" Height="900"
        MinWidth="1100" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource SpaceBrush}"
        Foreground="{StaticResource PrimaryTextBrush}"
        FontFamily="Segoe UI">
    <Window.Resources>
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Foreground" Value="#A9C0DA"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="NavBorder" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavBorder" Property="Background" Value="#1A3553"/>
                                <Setter Property="Foreground" Value="#55E5FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="NavBorder" Property="Background" Value="#21496D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Foreground" Value="#F4FBFF"/>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#1679D4" Offset="0"/>
                        <GradientStop Color="#13BBD9" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ActionBorder" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect Color="#269BFF" BlurRadius="18" ShadowDepth="0" Opacity="0.34"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ActionBorder" Property="Opacity" Value="0.86"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ActionBorder" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PanelCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="#263F5E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="15"/>
            <Setter Property="Padding" Value="22"/>
        </Style>
        <Storyboard x:Key="CorePulse" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="CoreGlow"
                             Storyboard.TargetProperty="Opacity"
                             From="0.28" To="0.82" Duration="0:0:2.4"/>
            <DoubleAnimation Storyboard.TargetName="CoreRing"
                             Storyboard.TargetProperty="Opacity"
                             From="0.55" To="1" Duration="0:0:2.4"/>
        </Storyboard>
    </Window.Resources>

    <Grid>
        <Grid.Background>
            <RadialGradientBrush GradientOrigin="0.78,0.08" Center="0.78,0.08" RadiusX="0.9" RadiusY="0.9">
                <GradientStop Color="#102C4B" Offset="0"/>
                <GradientStop Color="#080F1D" Offset="0.72"/>
            </RadialGradientBrush>
        </Grid.Background>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Navigation -->
        <Border Grid.Column="0" Background="#0A1424" BorderBrush="#1B3049" BorderThickness="0,0,1,0">
            <DockPanel Margin="20,25">
                <StackPanel DockPanel.Dock="Top">
                    <StackPanel Orientation="Horizontal" Margin="3,0,0,38">
                        <Grid Width="34" Height="34">
                            <Ellipse Stroke="#37CFFF" StrokeThickness="1.5" Opacity="0.9"/>
                            <Ellipse Width="12" Height="12" Fill="#37CFFF">
                                <Ellipse.Effect>
                                    <DropShadowEffect Color="#37CFFF" BlurRadius="15" ShadowDepth="0"/>
                                </Ellipse.Effect>
                            </Ellipse>
                        </Grid>
                        <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="QUANTUM" FontSize="15" FontWeight="Bold" Foreground="#F2FAFF"/>
                            <TextBlock Text="CORE SYSTEMS" FontSize="9" Foreground="#53DDF8"/>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="WORKSPACE" Foreground="#58738F" FontSize="10" FontWeight="Bold" Margin="12,0,0,12"/>
                    <Button Style="{StaticResource NavButton}" Background="#142B45" Foreground="#55E5FF" Content="◈   Operations" Margin="0,0,0,5"/>
                    <Button Style="{StaticResource NavButton}" Content="▣   Backup Jobs" Margin="0,0,0,5"/>
                    <Button Style="{StaticResource NavButton}" Content="↻   Restore Center" Margin="0,0,0,5"/>
                    <Button Style="{StaticResource NavButton}" Content="◷   Schedules" Margin="0,0,0,26"/>
                    <TextBlock Text="SYSTEM" Foreground="#58738F" FontSize="10" FontWeight="Bold" Margin="12,0,0,12"/>
                    <Button Style="{StaticResource NavButton}" Content="▤   Activity Logs" Margin="0,0,0,5"/>
                    <Button Style="{StaticResource NavButton}" Content="◇   Destinations" Margin="0,0,0,5"/>
                    <Button Style="{StaticResource NavButton}" Content="⚙   Settings"/>
                </StackPanel>
                <Border DockPanel.Dock="Bottom" Background="#101F33" BorderBrush="#294563" BorderThickness="1" CornerRadius="11" Padding="13">
                    <StackPanel>
                        <TextBlock Text="ENGINE STATUS" FontSize="9" Foreground="#7894B2"/>
                        <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                            <Ellipse Width="7" Height="7" Fill="#47E6B0" VerticalAlignment="Center"/>
                            <TextBlock Text="  Ready for initialization" FontSize="11" Foreground="#B8D0E7"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </DockPanel>
        </Border>

        <!-- Main workspace -->
        <Grid Grid.Column="1" Margin="38,30,38,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,30">
                <StackPanel>
                    <TextBlock Text="CONTROL CENTER / OVERVIEW" FontSize="10" Foreground="#55DDF7"/>
                    <TextBlock Text="Quantum Operations" FontSize="30" FontWeight="SemiBold" Margin="0,7,0,4"/>
                    <TextBlock Text="Your backup environment, unified in one command space." FontSize="13" Foreground="{StaticResource MutedTextBrush}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <Border Background="#102A3A" BorderBrush="#23617A" BorderThickness="1" CornerRadius="20" Padding="12,7" Margin="0,4,12,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Fill="#48E5B5" VerticalAlignment="Center"/>
                            <TextBlock Text="  SYSTEM STANDBY" FontSize="10" Foreground="#8FEBD0" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>
                    <Button Style="{StaticResource ActionButton}" Content="＋  NEW BACKUP" Margin="0,0,0,0" Click="NewBackup_Click"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Margin="0,0,0,22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource PanelCard}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="TOTAL BACKUPS" Foreground="#8CA7C5" FontSize="10"/>
                        <TextBlock x:Name="TotalBackupsValue" Text="0" FontSize="30" FontWeight="Light" Foreground="#F0F8FF" Margin="0,8,0,2"/>
                        <TextBlock x:Name="TotalBackupsCaption" Text="No backup records yet" FontSize="11" Foreground="#6886A5"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource PanelCard}" Margin="6,0">
                    <StackPanel>
                        <TextBlock Text="STORAGE USED" Foreground="#8CA7C5" FontSize="10"/>
                        <TextBlock x:Name="LastBackupValue" Text="—" FontSize="30" FontWeight="Light" Foreground="#F0F8FF" Margin="0,8,0,2"/>
                        <TextBlock Text="Awaiting destination scan" FontSize="11" Foreground="#6886A5"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource PanelCard}" Margin="12,0,0,0">
                    <StackPanel>
                        <TextBlock Text="LAST BACKUP" Foreground="#8CA7C5" FontSize="10"/>
                        <TextBlock Text="—" FontSize="30" FontWeight="Light" Foreground="#F0F8FF" Margin="0,8,0,2"/>
                        <TextBlock x:Name="LastBackupCaption" Text="No operations performed" FontSize="11" Foreground="#6886A5"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.35*"/>
                    <ColumnDefinition Width="0.85*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource PanelCard}" Margin="0,0,12,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="QUANTUM CORE" Foreground="#55DDF7" FontSize="10"/>
                            <TextBlock Text="Operations Monitor" FontSize="19" FontWeight="SemiBold" Margin="0,6,0,0"/>
                        </StackPanel>
                        <Grid Grid.Row="1" MinHeight="230">
                            <Ellipse x:Name="CoreGlow" Width="190" Height="190" Fill="#123F70" Opacity="0.55">
                                <Ellipse.Effect>
                                    <BlurEffect Radius="35"/>
                                </Ellipse.Effect>
                            </Ellipse>
                            <Ellipse x:Name="CoreRing" Width="154" Height="154" Stroke="#258DCE" StrokeThickness="1.2" Opacity="0.8">
                                <Ellipse.RenderTransform>
                                    <RotateTransform CenterX="77" CenterY="77"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                            <Ellipse Width="122" Height="122" Stroke="#3DDFFF" StrokeThickness="1.5" Opacity="0.75">
                                <Ellipse.Fill>
                                    <RadialGradientBrush>
                                        <GradientStop Color="#246A9A" Offset="0"/>
                                        <GradientStop Color="#102A49" Offset="0.7"/>
                                        <GradientStop Color="#0C1B30" Offset="1"/>
                                    </RadialGradientBrush>
                                </Ellipse.Fill>
                                <Ellipse.Effect>
                                    <DropShadowEffect Color="#21BFFF" BlurRadius="30" ShadowDepth="0" Opacity="0.8"/>
                                </Ellipse.Effect>
                            </Ellipse>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="CORE" FontSize="10" Foreground="#8DEBFF" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="CoreStateText" Text="IDLE" FontSize="21" FontWeight="Light" Foreground="White" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Grid>
                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
                            <Ellipse Width="6" Height="6" Fill="#45E6B4" VerticalAlignment="Center"/>
                            <TextBlock x:Name="ActivityStatusText" Text="  No active operations" FontSize="11" Foreground="#8CA7C5"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <StackPanel Grid.Column="1">
                    <Border Style="{StaticResource PanelCard}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="QUICK ACCESS" Foreground="#55DDF7" FontSize="10"/>
                            <Button Style="{StaticResource ActionButton}" Content="＋  Create backup" HorizontalAlignment="Stretch" Margin="0,15,0,8" Click="NewBackup_Click"/>
                            <Button Style="{StaticResource NavButton}" Content="↻  Restore a backup" HorizontalAlignment="Stretch"/>
                            <Button Style="{StaticResource NavButton}" Content="◷  Configure schedule" HorizontalAlignment="Stretch"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource PanelCard}">
                        <StackPanel>
                            <TextBlock Text="SYSTEM ACTIVITY" Foreground="#55DDF7" FontSize="10"/>
                            <TextBlock x:Name="ActivityTitle" Text="Awaiting first operation" FontSize="13" Margin="0,15,0,5"/>
                            <TextBlock x:Name="ActivityDescription" Text="When you create a backup, its progress and events will appear here." TextWrapping="Wrap" Foreground="#7894B2" FontSize="11" LineHeight="18"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="3" Margin="0,18,0,0">
                <TextBlock Text="QUANTUM CORE  •  WINDOWS DESKTOP" FontSize="9" Foreground="#526D89" VerticalAlignment="Center"/>
                <TextBlock Text="UI FOUNDATION / PREVIEW" FontSize="9" Foreground="#526D89" HorizontalAlignment="Right"/>
            </Grid>
        </Grid>
    </Grid>
    <Window.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard Storyboard="{StaticResource CorePulse}"/>
        </EventTrigger>
    </Window.Triggers>
</Window>
