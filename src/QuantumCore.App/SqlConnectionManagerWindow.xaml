<Window x:Class="QuantumCore.App.SqlConnectionManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SQL Connection Manager — Quantum Core" Width="850" Height="790"
        MinWidth="760" MinHeight="680" WindowStartupLocation="CenterOwner"
        Background="#0B1627" Foreground="#EDF7FF" FontFamily="Segoe UI">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#EAF8FF"/>
            <Setter Property="Background" Value="#183653"/>
            <Setter Property="BorderBrush" Value="#315777"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="13,8"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#087FC4"/>
            <Setter Property="BorderBrush" Value="#20C6E8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#101F33"/>
            <Setter Property="Foreground" Value="#EDF7FF"/>
            <Setter Property="BorderBrush" Value="#31506F"/>
            <Setter Property="Padding" Value="9,7"/>
            <Setter Property="CaretBrush" Value="#55E5FF"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#123B60"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#2876A8"/>
            <Setter Property="Padding" Value="7"/>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#EDF7FF"/>
            <Setter Property="Background" Value="#102B49"/>
            <Setter Property="Padding" Value="8,6"/>
        </Style>
    </Window.Resources>
    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="QUANTUM CORE / DATA SOURCES" Foreground="#55DDF7" FontSize="10"/>
            <TextBlock Text="SQL Connection Manager" FontSize="27" FontWeight="SemiBold" Margin="0,5,0,3"/>
            <TextBlock Text="Save multiple SQL Server connections and choose the database to protect." Foreground="#8CA7C5" FontSize="12"/>
        </StackPanel>
        <Border Grid.Row="1" Background="#101F33" BorderBrush="#294563" BorderThickness="1" CornerRadius="10" Padding="15" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="SAVED CONNECTIONS" Foreground="#55DDF7" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,7"/>
                    <ComboBox x:Name="SavedConnectionsCombo" DisplayMemberPath="Name" SelectionChanged="SavedConnectionsCombo_SelectionChanged" MinWidth="300"/>
                </StackPanel>
                <Button Grid.Column="1" Content="＋ New connection" VerticalAlignment="Bottom" Margin="12,0,0,0" Click="NewConnection_Click"/>
            </Grid>
        </Border>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="0.9*"/></Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,18,0">
                <TextBlock Text="CONNECTION DETAILS" Foreground="#55DDF7" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,10"/>
                <TextBlock Text="Connection name" Foreground="#8CA7C5" FontSize="11" Margin="0,0,0,5"/>
                <TextBox x:Name="NameBox" Margin="0,0,0,12"/>
                <TextBlock Text="SQL Server / instance" Foreground="#8CA7C5" FontSize="11" Margin="0,0,0,5"/>
                <DockPanel Margin="0,0,0,7">
                    <Button DockPanel.Dock="Right" Content="Discover" Click="Discover_Click" Margin="8,0,0,0"/>
                    <TextBox x:Name="ServerBox"/>
                </DockPanel>
                <TextBlock Text="Detected local instances" Foreground="#8CA7C5" FontSize="11" Margin="0,0,0,5"/>
                <ComboBox x:Name="DiscoveredServersCombo" SelectionChanged="DiscoveredServersCombo_SelectionChanged" Margin="0,0,0,13"/>
                <TextBlock Text="Authentication" Foreground="#8CA7C5" FontSize="11" Margin="0,0,0,5"/>
                <ComboBox x:Name="AuthenticationCombo" SelectedIndex="0" SelectionChanged="AuthenticationCombo_SelectionChanged" Margin="0,0,0,12">
                    <ComboBoxItem Content="Windows Authentication"/>
                    <ComboBoxItem Content="SQL Server Authentication"/>
                </ComboBox>
                <TextBlock Text="Username" Foreground="#8CA7C5" FontSize="11" Margin="0,0,0,5"/>
                <TextBox x:Name="UsernameBox" IsEnabled="False" Margin="0,0,0,12"/>
                <TextBlock Text="Password" Foreground="#8CA7C5" FontSize="11" Margin="0,0,0,5"/>
                <PasswordBox x:Name="PasswordBox" IsEnabled="False" Background="#101F33" Foreground="#EDF7FF" BorderBrush="#31506F" Padding="9,7" Margin="0,0,0,14"/>
                <WrapPanel>
                    <Button Content="Test &amp; load databases" Style="{StaticResource PrimaryButton}" Click="TestConnection_Click"/>
                    <Button Content="Save connection" Click="SaveConnection_Click" Margin="0"/>
                </WrapPanel>
                <Button Content="Remove selected connection" HorizontalAlignment="Left" Margin="0,12,0,0" Click="RemoveConnection_Click"/>
            </StackPanel>
            <Border Grid.Column="1" Background="#101F33" BorderBrush="#294563" BorderThickness="1" CornerRadius="10" Padding="14">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="AVAILABLE DATABASES" Foreground="#55DDF7" FontSize="10" FontWeight="SemiBold"/>
                        <TextBlock Text="Select a database for the backup operation." Foreground="#8CA7C5" FontSize="11" Margin="0,5,0,12" TextWrapping="Wrap"/>
                    </StackPanel>
                    <ListBox x:Name="DatabasesList" Grid.Row="1" Background="#0B1627" Foreground="#D9EDFF" BorderBrush="#294563" SelectionMode="Single" Padding="7"/>
                    <TextBlock x:Name="DatabaseStatusText" Grid.Row="2" Text="Connect to a SQL Server to list its databases." Foreground="#7894B2" FontSize="10" TextWrapping="Wrap" Margin="0,12,0,0"/>
                </Grid>
            </Border>
        </Grid>
        <DockPanel Grid.Row="3" Margin="0,18,0,0">
            <TextBlock x:Name="StatusText" Text="Credentials are protected for this Windows user." Foreground="#7894B2" FontSize="10" VerticalAlignment="Center" TextWrapping="Wrap"/>
            <Button DockPanel.Dock="Right" Content="Close" Click="Close_Click" Margin="8,0,0,0"/>
        </DockPanel>
    </Grid>
</Window>
